# Per-machine settings read by docker compose. generate.sh creates .env from
# .env.example once; .env is gitignored, so edit it freely.
{% if "vnc" in overlays %}

# Password for the noVNC/VNC desktop (mac-vnc variant).
VNC_PASSWORD={{ display.vnc.password }}

# Resolution of the virtual desktop.
VNC_GEOMETRY={{ display.vnc.geometry }}
{% endif %}
