#!/usr/bin/env python3
# {{ header }}
"""Regenerate Pyright/Pylance extraPaths from the ROS 2 workspace's packages.

ament_python packages install in "develop" mode: colcon drops an
.egg-link in install/<pkg>/lib/python3.*/site-packages that points at
build/<pkg>, rather than copying real .py files there. That's fine for the
ROS 2 runtime (ament/setuptools follow it), but Pyright doesn't resolve
.egg-link files, so those packages need their src/ directory on extraPaths
instead. Which packages need that, and what their paths are, is exactly
what `colcon list` already knows -- so this regenerates pyrightconfig.json
and .vscode/settings.json from that instead of hand-maintained lists, which
otherwise silently go stale when a new ament_python package is added.

Run standalone for a quick refresh, or via colcon_build.sh (`cb`),
which runs this automatically after every build.
"""

import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

PROJECT_ROOT = Path({{ workspace.container_path | quote }})
ROS_WS = Path({{ ros_ws | quote }})
WS_PREFIX = "" if ROS_WS == PROJECT_ROOT else f"{ROS_WS.relative_to(PROJECT_ROOT)}/"
PYTHON_TAG = f"python3.{sys.version_info.minor}"

# IDE files to update, as seen inside the container (None: not generated).
PYRIGHT_CONFIG = {{ (ide_files.pyright | quote) if ide_files.pyright else "None" }}
VSCODE_SETTINGS = {{ (ide_files.settings | quote) if ide_files.settings else "None" }}

SYSTEM_PATHS = [
    f"/opt/ros/{{ ros.distro }}/lib/{PYTHON_TAG}/site-packages",
    f"/opt/ros/{{ ros.distro }}/local/lib/{PYTHON_TAG}/dist-packages",
]

# e.g. "my_package\tsrc/my_package\t(ros.ament_python)"
LIST_LINE_RE = re.compile(r"^(\S+)\t(\S+)\t\(ros\.(\S+)\)$")


@dataclass
class Package:
    name: str
    rel_path: str  # relative to ROS_WS
    build_type: str


def list_packages() -> list[Package]:
    """Every colcon-discovered package in the workspace."""
    colcon = shutil.which("colcon")
    if colcon is None:
        raise RuntimeError("colcon not found on PATH.")
    result = subprocess.run(  # noqa: S603
        [colcon, "list"], cwd=ROS_WS, capture_output=True, text=True, check=True
    )
    packages = []
    for line in result.stdout.splitlines():
        match = LIST_LINE_RE.match(line)
        if match:
            packages.append(Package(*match.groups()))
    return packages


def has_real_site_packages(pkg_name: str) -> bool:
    """True if install/<pkg> has actual installed modules, not just an egg-link."""
    site_packages = ROS_WS / "install" / pkg_name / "lib" / PYTHON_TAG / "site-packages"
    if not site_packages.is_dir():
        return False
    return any(
        not (entry.name.endswith(".egg-link") or entry.name.endswith(".egg-info"))
        for entry in site_packages.iterdir()
    )


def compute_extra_paths() -> list[str]:
    """Workspace-root-relative extraPaths for every workspace package Pyright needs help finding."""
    paths = []
    for pkg in list_packages():
        if pkg.build_type == "ament_python":
            paths.append(f"{WS_PREFIX}{pkg.rel_path}")
        elif has_real_site_packages(pkg.name):
            paths.append(f"{WS_PREFIX}install/{pkg.name}/lib/{PYTHON_TAG}/site-packages")
    return sorted(paths)


def replace_extra_paths_array(path: Path, key: str, paths: list[str]) -> None:
    """Targeted regex replace of one `"key": [...]` array, leaving the rest of the file untouched.

    Both files are JSONC (comments, trailing commas), which trips up a strict
    json.loads/dumps round-trip -- so this edits the array in place as text
    instead of reserializing the whole file.
    """
    text = path.read_text()
    rendered = ",\n".join(f'    "{p}"' for p in paths)
    replacement = f'"{key}": [\n{rendered}\n  ]'
    pattern = re.compile(rf'"{re.escape(key)}"\s*:\s*\[.*?\]', re.DOTALL)
    text, count = pattern.subn(lambda _: replacement, text, count=1)
    if count == 0:
        raise RuntimeError(f"Could not find {key!r} in {path}")
    path.write_text(text)


def update_pyrightconfig(extra_paths: list[str]) -> None:
    if PYRIGHT_CONFIG and Path(PYRIGHT_CONFIG).exists():
        replace_extra_paths_array(Path(PYRIGHT_CONFIG), "extraPaths", SYSTEM_PATHS + extra_paths)


def update_settings_json(extra_paths: list[str]) -> None:
    if not (VSCODE_SETTINGS and Path(VSCODE_SETTINGS).exists()):
        return
    workspace_paths = ["${workspaceFolder}/" + p for p in extra_paths]
    for key in ("python.autoComplete.extraPaths", "python.analysis.extraPaths"):
        replace_extra_paths_array(Path(VSCODE_SETTINGS), key, SYSTEM_PATHS + workspace_paths)


def main() -> None:
    extra_paths = compute_extra_paths()
    update_pyrightconfig(extra_paths)
    update_settings_json(extra_paths)
    print(f"Regenerated extraPaths for {len(extra_paths)} workspace package(s).")


if __name__ == "__main__":
    main()
