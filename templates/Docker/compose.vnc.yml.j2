# {{ header }}
#
# Overlay for hosts without an X server (macOS): the container runs its own
# Xfce desktop, served by noVNC at http://localhost:{{ display.vnc.novnc_port }}/vnc.html
# (native VNC clients: localhost:{{ display.vnc.vnc_port }}). Password: VNC_PASSWORD in .env.
services:
  {{ service }}:
    # Loopback only: the desktop is a root shell with the workspace mounted, behind a
    # weak VNC password. From another machine, tunnel instead:
    #   ssh -L {{ display.vnc.novnc_port }}:localhost:{{ display.vnc.novnc_port }} <this-host>
    ports:
      - "127.0.0.1:{{ display.vnc.novnc_port }}:6080"
      - "127.0.0.1:{{ display.vnc.vnc_port }}:5901"

    environment:
      ENABLE_VNC: "true"
      VNC_PASSWORD: ${VNC_PASSWORD:-{{ display.vnc.password }}}
      VNC_GEOMETRY: ${VNC_GEOMETRY:-{{ display.vnc.geometry }}}
      DISPLAY: ":1"
      LIBGL_ALWAYS_SOFTWARE: "1"

    # Host shared memory: helps Gazebo/RViz with shared-memory transport and large point clouds
    ipc: host
